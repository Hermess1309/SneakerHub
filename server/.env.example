# Server port
PORT=3000

# Connection string for your local MongoDB database
MONGODB_URI=mongodb://127.0.0.1:27017/sneaker

# Secret key used for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_123456_change_me

# Client URL (Vite dev server default port is 5173)
CLIENT_URL=http://localhost:5173

# Cloudinary configs for uploading images
CLOUD_DINARY_NAME=your_cloudinary_cloud_name
CLOUD_DINARY_KEY=your_cloudinary_api_key
CLOUD_DINARY_SECRET=your_cloudinary_api_secret

# Google OAuth2 / SMTP config (Optional for sending emails)
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
REDIRECT_URI=your_redirect_uri
REFRESH_TOKEN=your_refresh_token
EMAIL_USER=your_email@gmail.com

# Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# VNPay Sandbox Config
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECURE_SECRET=your_vnpay_hash_secret
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay-callback

# MoMo Sandbox Config
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_HOST=test-payment.momo.vn
MOMO_RETURN_URL=http://localhost:3000/api/payment/momo-callback
